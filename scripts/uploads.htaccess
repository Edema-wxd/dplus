# Copied to ~/public_html/uploads/.htaccess on the shared server, where the web
# server hands out uploaded files without going through Node.
# Uploads are saved with an extension chosen from their type (src/lib/upload-slots.ts),
# but nothing in here should ever run as a script either way.
Options -ExecCGI -Indexes
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .pl .py .cgi .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8
<FilesMatch "\.(php\d?|phtml|pl|py|cgi|sh|htaccess)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  # Files never change once saved: every upload gets a new key.
  Header set Cache-Control "public, max-age=31536000, immutable"
  # Shopper SVGs could carry scripts; never let one run on our origin.
  <FilesMatch "\.svg$">
    Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
  </FilesMatch>
  # Shopper artwork is private to the order; keep it out of search results.
  # Public uploads (brochures, hampers, portfolio) stay indexable.
  <If "%{REQUEST_URI} =~ m#^/uploads/customerArtwork/#">
    Header set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>
